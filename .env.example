# ============================================================
#  A9 Marketing System 环境变量配置
#  使用方法：复制此文件为 .env，并修改其中的值
#  命令：cp .env.example .env
# ============================================================

# ---------- 会话与安全 ----------

# Session 密钥（必填）：用于签名 Express 会话 cookie
# 生成强随机字符串：openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# 管理员初始密码（必填）：首次启动时创建管理员账户使用
# 请设置为强密码（至少 12 位，含大小写字母、数字、特殊字符）
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# 管理员邮箱白名单（逗号分隔）：命中即视为管理员，可访问用户管理后台
ADMIN_EMAILS=admin@a9.com

# 会话 cookie 是否仅通过 HTTPS 传输
# 本地部署：false；生产环境（HTTPS）：true
SESSION_COOKIE_SECURE=false

# ---------- Grist 配置 ----------

# Grist 对外端口（由 Caddy 代理，所有请求先经 A9 鉴权）
GRIST_PORT=8484

# Grist 默认管理员邮箱
GRIST_DEFAULT_EMAIL=admin@a9.com
GRIST_ADMIN_EMAIL=admin@a9.com

# Grist 服务模式（保持 true 即可）
GRIST_IN_SERVICE=true

# Grist 服务 API Key：用于后端访问 Grist REST API
# 首次启动 Grist 后，在 Grist 控制台 → Settings → API 生成
# 留空则后端会尝试通过 forward_auth 机制访问
GRIST_API_KEY=

# 指定 Grist 文档 ID（留空则自动使用工作区第一个文档）
GRIST_DOC_ID=

# Grist 看板文档路径（留空则自动发现）
GRIST_DASHBOARD_PATH=

# Grist 外部可达 URL（用于生成正确的重定向链接）
# 本地部署：http://localhost:8484
# 生产环境：https://your-domain.com
GRIST_EXTERNAL_URL=http://localhost:8484

# App 内部主页 URL（通常与 GRIST_EXTERNAL_URL 一致）
APP_HOME_URL=http://localhost:8484

# ---------- App 配置 ----------

# A9 App 对外端口
APP_PORT=3000

# ---------- Munchkin AI Agent 配置 ----------

# OpenCode API Key（必填）：Munchkin LLM 调用密钥
# 从 https://opencode.ai 获取，或替换为其他 provider 的 key
OPENCODE_API_KEY=

# Agent 内部通信 token（必填）：app 与 MCP server 之间鉴权
# 生成强随机字符串：openssl rand -hex 32
AGENT_INTERNAL_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN

# Munchkin WebSocket token secret（必填）：gateway 鉴权用
# 生成强随机字符串：openssl rand -hex 32
MUNCHKIN_TOKEN_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
