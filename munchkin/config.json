{
  "agents": {
    "defaults": {
      "workspace": "~/.munchkin/workspace",
      "model": "deepseek-v4-flash-free",
      "provider": "opencode",
      "maxTokens": 8192,
      "contextWindowTokens": 262144,
      "temperature": 0.1,
      "maxToolIterations": 200,
      "maxToolResultChars": 16000,
      "providerRetryMode": "standard",
      "timezone": "Asia/Shanghai",
      "botName": "Munchkin",
      "unifiedSession": false,
      "disabledSkills": [],
      "maxMessages": 120,
      "consolidationRatio": 0.5
    }
  },
  "channels": {
    "sendProgress": true,
    "sendToolHints": true,
    "showReasoning": true,
    "websocket": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8765,
      "allow_from": [
        "*"
      ],
      "streaming": true,
      "token_issue_secret": "${MUNCHKIN_TOKEN_SECRET}"
    }
  },
  "providers": {
    "opencode": {
      "apiKey": "${OPENCODE_API_KEY}",
      "apiBase": "https://opencode.ai/zen/v1",
      "apiType": "auto"
    }
  },
  "tools": {
    "web": {
      "enable": false
    },
    "exec": {
      "enable": false
    },
    "cliApps": {
      "enable": false
    },
    "restrictToWorkspace": true,
    "mcpServers": {
      "grist": {
        "type": "stdio",
        "command": "python3",
        "args": [
          "/app/mcp-grist/server.py"
        ],
        "env": {
          "GRIST_URL": "http://grist:8484",
          "GRIST_API_KEY": "${GRIST_API_KEY}",
          "A9_API_URL": "http://127.0.0.1:3000",
          "A9_AGENT_TOKEN": "${AGENT_INTERNAL_TOKEN}"
        },
        "toolTimeout": 30,
        "enabledTools": [
          "list_tables",
          "get_table_schema",
          "aggregate",
          "save_widget"
        ]
      }
    }
  },
  "model_presets": {}
}
